<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies to DEBUG builds only. Trusts user-installed CAs for testing with SSL-inspecting corporate proxies.
  RELEASE builds omit this override and trust system CAs only.
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
